VNMS_REGISTRY=ghcr.io
VNMS_IMAGE_NAMESPACE=organization-or-user
VNMS_RELEASE_TAG=0.4.0
VNMS_ENV_FILE=/etc/vnms/vnms.env
VNMS_HTTP_BIND=0.0.0.0
VNMS_HTTP_PORT=80
VNMS_ALLOWED_ORIGINS=http://vnms.example.internal
# Leave blank to run without AI; install.sh provisions the matching key separately.
ACTIVE_AI_MODEL=provider/model-name
# Runtime secret values are deliberately absent. install.sh stores root-only
# secret files below /etc/vnms/secrets and configures *_FILE paths in Compose.
