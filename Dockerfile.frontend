# Stage 1: Build the React application (Upgraded to Node 20)
FROM node:20-alpine AS build

ARG VITE_API_URL=/api
ENV VITE_API_URL="$VITE_API_URL"

WORKDIR /app

# Copy package.json and install dependencies
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# Copy the rest of the frontend code and build it
COPY frontend/ .
RUN npm run build

# Stage 2: Serve the app with Nginx
FROM nginx:alpine

ARG VNMS_VERSION=0.0.0-dev
ARG VNMS_BUILD_SHA=unknown
ARG VNMS_BUILD_TIME=unknown
LABEL org.opencontainers.image.title="VNMS Frontend" \
      org.opencontainers.image.version="$VNMS_VERSION" \
      org.opencontainers.image.revision="$VNMS_BUILD_SHA" \
      org.opencontainers.image.created="$VNMS_BUILD_TIME"

# Copy the built React files into Nginx's web directory
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
RUN mkdir -p /var/log/vnms/frontend && nginx -t

# Expose port 80 for the web interface
EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=12 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]