# Use an official Python runtime as a parent image
FROM python:3.10-slim

ARG VNMS_VERSION=0.0.0-dev
ARG VNMS_BUILD_SHA=unknown
ARG VNMS_BUILD_TIME=unknown
LABEL org.opencontainers.image.title="VNMS Backend" \
      org.opencontainers.image.version="$VNMS_VERSION" \
      org.opencontainers.image.revision="$VNMS_BUILD_SHA" \
      org.opencontainers.image.created="$VNMS_BUILD_TIME"

# Set environment variables for non-interactive installs and pipx
ENV DEBIAN_FRONTEND=noninteractive
ENV PIPX_HOME=/opt/pipx
ENV PIPX_BIN_DIR=/usr/local/bin
ENV PATH="/usr/local/bin:$PATH"
ENV VNMS_VERSION="$VNMS_VERSION"
ENV VNMS_BUILD_SHA="$VNMS_BUILD_SHA"
ENV VNMS_BUILD_TIME="$VNMS_BUILD_TIME"

# Install system dependencies required for SSH, Ansible, and ping
RUN apt-get update && apt-get install -y \
    sshpass \
    iputils-ping \
    pipx \
    git \
    && rm -rf /var/lib/apt/lists/*

# Reproduce the validated Ansible controller and both SSH transports exactly.
RUN pipx install --include-deps ansible==14.2.0
RUN pipx inject --force ansible ansible-core==2.21.2 paramiko==4.0.0 ansible-pylibssh==1.4.0 scp==0.16.1

# Pin the collections exercised by the Cisco network_cli workflow.
RUN ansible-galaxy collection install 'ansible.netcommon:==8.6.0' 'cisco.ios:==11.4.2'

# Fail the build if the isolated Ansible interpreter loses validated compatibility.
RUN /opt/pipx/venvs/ansible/bin/python -c "import importlib.metadata as metadata; import paramiko; import scp; assert metadata.version('ansible') == '14.2.0'; assert metadata.version('ansible-core') == '2.21.2'; assert metadata.version('ansible-pylibssh') == '1.4.0'; assert metadata.version('scp') == '0.16.1'; assert scp.__file__.startswith('/opt/pipx/venvs/ansible/'); assert paramiko.__version__ == '4.0.0'; assert 'diffie-hellman-group14-sha1' in paramiko.Transport._preferred_kex; assert 'ssh-rsa' in paramiko.Transport._preferred_keys"
RUN ansible-galaxy collection list | grep -Eq '^ansible\.netcommon[[:space:]]+8\.6\.0[[:space:]]*$' && \
    ansible-galaxy collection list | grep -Eq '^cisco\.ios[[:space:]]+11\.4\.2[[:space:]]*$'

# Set the working directory for the API
WORKDIR /app

# Install Python API dependencies (FastAPI, SQLAlchemy, Netmiko, etc.)
# Note: Adjust this list to match your actual requirements.txt
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the backend source code
# Runtime hosts do not need the repository; image contents remain inspectable by Docker administrators.
COPY backend/ .

# Runtime /version reads this image-owned file. Production host env files only
# select VNMS_RELEASE_TAG and cannot override the metadata reported by the API.
RUN printf '{"version":"%s","build_sha":"%s","build_time":"%s"}\n' \
    "$VNMS_VERSION" "$VNMS_BUILD_SHA" "$VNMS_BUILD_TIME" \
    > /app/vnms_build_metadata.json

# Expose the FastAPI port
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=12 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3).read()" || exit 1

# Command to run the Uvicorn server
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--log-level", "warning"]
